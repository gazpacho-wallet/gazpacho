# SPDX-License-Identifier: MIT
# Turns the interface's files (web/) into one C source, so the program serves
# them from memory and reads no file at request time (spec/local-api.md 5.4).
#
#   cmake -DWEB_DIR=<web> -DFILES=<a|b|c> -DOUT=<static_files.c> -P embed.cmake
#
# Plain CMake, so the build needs no other tool. Each file becomes a byte
# array; the table gives its path, its Content-Type header and whether it is
# one of the interface's pages (which get the page headers of 5.4).
string(REPLACE "|" ";" FILE_LIST "${FILES}")
set(SRC "/* GENERATED by ports/api/embed.cmake from web/; do not edit. */\n#include \"internal.h\"\n\n")
set(TABLE "")
set(N 0)
set(ROW "0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,")
foreach(f ${FILE_LIST})
  if(NOT EXISTS "${WEB_DIR}/${f}")
    message(FATAL_ERROR "embed.cmake: ${WEB_DIR}/${f} is missing")
  endif()
  file(READ "${WEB_DIR}/${f}" HEX_DATA HEX)
  string(LENGTH "${HEX_DATA}" HEX_LEN)
  if(HEX_LEN EQUAL 0)
    message(FATAL_ERROR "embed.cmake: ${f} is empty")
  endif()
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX_DATA}")
  string(REGEX REPLACE "(${ROW})" "\\1\n" BYTES "${BYTES}")
  if(f MATCHES "\\.html$")
    set(CTYPE "NULL")
    set(PAGE 1)
  elseif(f MATCHES "\\.css$")
    set(CTYPE "\"Content-Type: text/css; charset=utf-8\\r\\n\"")
    set(PAGE 0)
  elseif(f MATCHES "\\.js$")
    set(CTYPE "\"Content-Type: text/javascript; charset=utf-8\\r\\n\"")
    set(PAGE 0)
  elseif(f MATCHES "\\.svg$")
    set(CTYPE "\"Content-Type: image/svg+xml\\r\\n\"")
    set(PAGE 0)
  else()
    message(FATAL_ERROR "embed.cmake: ${f} has no known type")
  endif()
  string(APPEND SRC "static const unsigned char F${N}[] = {\n${BYTES}\n};\n")
  string(APPEND TABLE "    {\"/${f}\", ${CTYPE}, F${N}, sizeof F${N}, ${PAGE}},\n")
  if(f STREQUAL "index.html")
    string(APPEND TABLE "    {\"/\", ${CTYPE}, F${N}, sizeof F${N}, ${PAGE}},\n")
  endif()
  math(EXPR N "${N} + 1")
endforeach()
string(APPEND SRC "\nconst gz_static_file gz_static_files[] = {\n${TABLE}};\n")
string(APPEND SRC "const size_t gz_static_nfiles = sizeof gz_static_files / sizeof gz_static_files[0];\n")
file(WRITE "${OUT}" "${SRC}")
